[
  {
    "type": "separator",
    "label": "Features"
  },
  {
    "type": "checkbox",
    "label": "Music player card",
    "property": "zia.features.media-player",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Find in page bar",
    "property": "zia.features.find-bar",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Icon picker (5,166 Tabler icons, outline and solid)",
    "property": "zia.features.icon-picker",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Undo a closed tab with Cmd/Ctrl+Z",
    "property": "zia.features.undo-close",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Tab and folder hover cards",
    "property": "zia.features.tab-hover-cards",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Hover cards are slightly see-through, with what's behind them blurred",
    "property": "zia.cards.blur",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Name new folders and choose their icons with a local model (downloads ~25MB the first time)",
    "property": "zia.features.folder-icon-suggest",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Tabs"
  },
  {
    "type": "checkbox",
    "label": "Sound bars on playing tabs (off: Zen's speaker)",
    "property": "zia.tabs.sound-bars",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Tint the selected tab's glow and the sound bars with the site's colours",
    "property": "zia.tabs.favicon-glow",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "The last essential stretches across the rest of its row",
    "property": "zia.essentials.fill-row",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Split essentials (experimental): drag a two-site split onto the essentials",
    "property": "zia.essentials.split",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Asleep (unloaded) tabs, essentials and folders look dimmed",
    "property": "zia.tabs.dim-asleep",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Compact mode's sidebar is slightly see-through, with the page blurred behind it",
    "property": "zia.compact.sidebar-blur",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Page"
  },
  {
    "type": "checkbox",
    "label": "Toolbar takes the colour of the site (off: the theme's colour)",
    "property": "zia.toolbar.site-color",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Zia's rounded page corners (off: Zen's own)",
    "property": "zia.page.rounding",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Split view drop cards when dragging a tab onto the page (off: Zen's own)",
    "property": "zia.split.drop-cards",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "PDFs open in Dia's viewer look (off: Firefox's own; reopen a PDF to see the change)",
    "property": "zia.pdf.dia-style",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Address bar"
  },
  {
    "type": "checkbox",
    "label": "Dia-style address bar pop-up (off: Zen's own)",
    "property": "zia.urlbar.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Address bar pop-up takes the toolbar's colour as it opens (needs the site-coloured toolbar)",
    "property": "zia.urlbar.site-color",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Address bar pop-up is slightly see-through, with the page blurred behind it",
    "property": "zia.urlbar.pop-up-blur",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Address bar position",
    "property": "zia.urlbar.position",
    "defaultValue": "top",
    "options": [
      {
        "label": "Top",
        "value": "top"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      }
    ]
  },
  {
    "type": "separator",
    "label": "New tabs"
  },
  {
    "type": "checkbox",
    "label": "Cmd/Ctrl+T and + New Tab open a real tab (off: Zen's floating address bar)",
    "property": "zia.newtab.real-tab",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "New tabs open your default search engine's page",
    "property": "zia.newtab.search-engine",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Folders"
  },
  {
    "type": "checkbox",
    "label": "Folders open and close with a gentle spring",
    "property": "zia.folders.bounce",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Loading bar"
  },
  {
    "type": "checkbox",
    "label": "Use Zen's accent color for the loading bar (default: Zia blue)",
    "property": "zia.loading-bar.accent-color",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Picture-in-picture"
  },
  {
    "type": "checkbox",
    "label": "Dia-style picture-in-picture controls (off: Firefox's own)",
    "property": "zia.pip.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Push picture-in-picture against the side of the screen to tuck it away",
    "property": "zia.pip.tuck",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Picture-in-picture tucks into",
    "property": "zia.pip.tuck-spot",
    "defaultValue": "nearest",
    "options": [
      {
        "label": "The nearest side",
        "value": "nearest"
      },
      {
        "label": "Left side",
        "value": "left"
      },
      {
        "label": "Right side",
        "value": "right"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      },
      {
        "label": "Bottom-left corner",
        "value": "bottom-left"
      },
      {
        "label": "Bottom-right corner",
        "value": "bottom-right"
      }
    ]
  },
  {
    "type": "separator",
    "label": "Multiview"
  },
  {
    "type": "checkbox",
    "label": "\"Add to Multiview\" on videos and tabs: a tab that grids up videos and live streams",
    "property": "zia.multiview",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Multiview tab icon colour",
    "property": "zia.multiview.icon-color",
    "defaultValue": "zia",
    "options": [
      {
        "label": "Zia blue",
        "value": "zia"
      },
      {
        "label": "Space colour",
        "value": "space"
      }
    ]
  }
]
