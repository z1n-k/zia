[
  {
    "type": "separator",
    "label": "Features"
  },
  {
    "type": "checkbox",
    "label": "Music player card",
    "property": "zia.features.media-player",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Music player card stays when you send its video to picture-in-picture",
    "property": "zia.media.keep-with-pip",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Music player shows a YouTube channel's picture instead of the video's thumbnail",
    "property": "zia.media.youtube-channel-art",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Find in page bar",
    "property": "zia.features.find-bar",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Icon picker (5,166 Tabler icons, outline and solid)",
    "property": "zia.features.icon-picker",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Undo a closed tab with Cmd/Ctrl+Z",
    "property": "zia.features.undo-close",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Hold Cmd/Ctrl to show each tab's number, and go to it by number",
    "property": "zia.features.tab-numbers",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Tab numbers show all the time",
    "property": "zia.tab-numbers.always",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "Colour of the tab number you type",
    "property": "zia.tab-numbers.color",
    "defaultValue": "zia",
    "options": [
      {
        "label": "Zia blue",
        "value": "zia"
      },
      {
        "label": "The space's colour",
        "value": "space"
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Show the welcome tour after updates that bring something new",
    "property": "zia.welcome.show",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Show the welcome tour again (turns itself back off)",
    "property": "zia.welcome.again",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Show what's new in this version again (turns itself back off)",
    "property": "zia.welcome.whats-new-again",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "A glance shows on its tab as a small picture of the page, as in Dia",
    "property": "zia.glance.thumbnail",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Bookmarks, History and Synced Tabs panels in Zia's look",
    "property": "zia.sidebar-panels.style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Bookmarks, History and Synced Tabs panels beside the page, full height, as a second sidebar",
    "property": "zia.sidebar-panels.beside",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Liquid glass essentials: each tile bends the space's colours at its rim, like macOS Tahoe (experimental)",
    "property": "zia.liquid-glass",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Zen's own Library look (off: Zia's)",
    "property": "zia.library.zen-look",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Tab and folder hover cards",
    "property": "zia.features.tab-hover-cards",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Hover cards are slightly see-through, with what's behind them blurred",
    "property": "zia.cards.blur",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Name new folders and choose their icons with a local model (downloads ~25MB the first time)",
    "property": "zia.features.folder-icon-suggest",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Tabs"
  },
  {
    "type": "checkbox",
    "label": "Sound bars on playing tabs (off: Zen's speaker)",
    "property": "zia.tabs.sound-bars",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Sound bars always move, even when your system asks for less motion",
    "property": "zia.sound-bars.always-move",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Tint the selected tab's glow and the sound bars with the site's colours",
    "property": "zia.tabs.favicon-glow",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Hide the glow around the selected tab",
    "property": "zia.tabs.no-glow",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Essentials are Zia's narrower tiles (off: Zen's own widths)",
    "property": "zia.essentials.zia-width",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Two essentials to a row, so the sidebar can be made narrower",
    "property": "zia.essentials.two-per-row",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "The last essential stretches across the rest of its row",
    "property": "zia.essentials.fill-row",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Split essentials (experimental): drag a two-site split onto the essentials",
    "property": "zia.essentials.split",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Asleep (unloaded) tabs, essentials and folders look dimmed",
    "property": "zia.tabs.dim-asleep",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Compact mode's sidebar is slightly see-through, with the page blurred behind it",
    "property": "zia.compact.sidebar-blur",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Compact mode hides the top toolbar while the sidebar is out",
    "property": "zia.compact.hide-toolbar",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Hide the space's name at the top of the sidebar, keeping its icon (the sidebar no longer widens for a long name)",
    "property": "zia.sidebar.hide-space-name",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Show the space's name above the tabs, where Zen puts it, rather than at the top of the sidebar",
    "property": "zia.sidebar.space-name-in-list",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Page"
  },
  {
    "type": "checkbox",
    "label": "Toolbar takes the colour of the site (off: the theme's colour)",
    "property": "zia.toolbar.site-color",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Zia's rounded page corners (off: Zen's own)",
    "property": "zia.page.rounding",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "The page fills its space edge to edge, with no gap, rounded corners or shadow around it",
    "property": "zia.page.edge-to-edge",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Swiping back or forward shows Dia's round arrow, and holding it lists the pages (off: Firefox's arrow)",
    "property": "zia.swipe.dia-arrow",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Split view drop cards when dragging a tab onto the page (off: Zen's own)",
    "property": "zia.split.drop-cards",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "PDFs open in Zia's viewer look (off: Firefox's own; reopen a PDF to see the change)",
    "property": "zia.pdf.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Hide the window buttons (minimise, maximise, close) on Windows and Linux, for keyboard users",
    "property": "zia.window-buttons.hide",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Windows window buttons just dim on hover (off: Windows' own blocks, red behind close, as in Dia)",
    "property": "zia.window-buttons.dim",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Address bar"
  },
  {
    "type": "checkbox",
    "label": "Zia's address bar pop-up (off: Zen's own)",
    "property": "zia.urlbar.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Address bar pop-up takes the toolbar's colour as it opens (needs the site-coloured toolbar)",
    "property": "zia.urlbar.site-color",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Address bar pop-up is slightly see-through, with the page blurred behind it",
    "property": "zia.urlbar.pop-up-blur",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Address bar shows only the page's title, in the domain's colour, until clicked",
    "property": "zia.urlbar.title-only",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Address bar text is centred",
    "property": "zia.urlbar.center-text",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "Address bar position",
    "property": "zia.urlbar.position",
    "defaultValue": "top",
    "options": [
      {
        "label": "Top",
        "value": "top"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      }
    ]
  },
  {
    "type": "separator",
    "label": "New tabs"
  },
  {
    "type": "checkbox",
    "label": "Cmd/Ctrl+T and + New Tab open a real tab (off: Zen's floating address bar)",
    "property": "zia.newtab.real-tab",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "New tabs open your default search engine's page (off: Zen's new tab page, or an extension's if you use one)",
    "property": "zia.newtab.search-engine",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Cmd/Ctrl+T leaves the address bar ready to type in, the search page behind it (off: the page's own search box)",
    "property": "zia.newtab.focus-address-bar",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Folders"
  },
  {
    "type": "checkbox",
    "label": "Folders open and close with a gentle spring",
    "property": "zia.folders.bounce",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Coloured folders only show their colour when hovered or open",
    "property": "zia.folders.tint-when-open",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "A coloured folder's card (its tabs, shown on hover) takes the folder's colour",
    "property": "zia.folders.tint-card",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Rename downloads with AI"
  },
  {
    "type": "checkbox",
    "label": "Rename finished downloads with AI, with an undo (Tidy Downloads; needs an API key below, or Ollama on your machine; restart after turning on)",
    "property": "zia.features.tidy-downloads",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "The rename card has a glowing edge in the loading line's colour",
    "property": "zia.tidy-downloads.glow",
    "defaultValue": true
  },
