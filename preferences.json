[
  {
    "type": "separator",
    "label": "Look",
    "id": "zia-section-look"
  },
  {
    "type": "checkbox",
    "label": "Toolbar in the site's colour (off: the theme's)",
    "property": "zia.toolbar.site-color",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Loading bar in Zen's accent colour (off: Zia blue)",
    "property": "zia.loading-bar.accent-color",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Hide the glow around the selected tab",
    "property": "zia.tabs.no-glow",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Tint the selected tab's glow and sound bars with the site's colours",
    "property": "zia.tabs.favicon-glow",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Dim asleep tabs, essentials and folders",
    "property": "zia.tabs.dim-asleep",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Zia's rounded page corners (off: Zen's)",
    "property": "zia.page.rounding",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Page fills its space edge to edge, with no gap or shadow",
    "property": "zia.page.edge-to-edge",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Tabs and essentials",
    "id": "zia-section-tabs"
  },
  {
    "type": "checkbox",
    "label": "Hover cards for tabs and folders",
    "property": "zia.features.tab-hover-cards",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Hover cards are see-through, with what's behind blurred",
    "property": "zia.cards.blur",
    "defaultValue": true,
    "conditions": [
      {
        "if": {
          "property": "zia.features.tab-hover-cards",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "A coloured folder's hover card takes its colour",
    "property": "zia.folders.tint-card",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "zia.features.tab-hover-cards",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Sound bars on playing tabs (off: Zen's speaker)",
    "property": "zia.tabs.sound-bars",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Sound bars move even when your system asks for less motion",
    "property": "zia.sound-bars.always-move",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "zia.tabs.sound-bars",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Hold Cmd/Ctrl to number your tabs, and go to one by its number",
    "property": "zia.features.tab-numbers",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Tab numbers always showing",
    "property": "zia.tab-numbers.always",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "zia.features.tab-numbers",
          "value": true
        }
      }
    ]
  },
  {
    "type": "dropdown",
    "label": "Colour of the number you type",
    "property": "zia.tab-numbers.color",
    "defaultValue": "zia",
    "options": [
      {
        "label": "Zia blue",
        "value": "zia"
      },
      {
        "label": "The space's colour",
        "value": "space"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tab-numbers",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Cmd/Ctrl+Z reopens a closed tab",
    "property": "zia.features.undo-close",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "A glance shows on its tab as a small picture of the page",
    "property": "zia.glance.thumbnail",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Zia's narrower essentials (off: Zen's widths)",
    "property": "zia.essentials.zia-width",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Two essentials to a row, for a narrower sidebar",
    "property": "zia.essentials.two-per-row",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "The last essential stretches across its row",
    "property": "zia.essentials.fill-row",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Split essentials: drag a two-site split onto the essentials (experimental)",
    "property": "zia.essentials.split",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Sidebar and folders",
    "id": "zia-section-sidebar"
  },
  {
    "type": "dropdown",
    "label": "Text size in the sidebar",
    "property": "zia.sidebar.text-size",
    "defaultValue": "default",
    "options": [
      {
        "label": "Default",
        "value": "default"
      },
      {
        "label": "Small",
        "value": "small"
      },
      {
        "label": "Smaller",
        "value": "smaller"
      },
      {
        "label": "Large",
        "value": "large"
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Folders open and close with a spring",
    "property": "zia.folders.bounce",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Coloured folders show their colour only when hovered or open",
    "property": "zia.folders.tint-when-open",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Icon picker for folders and spaces (5,166 icons)",
    "property": "zia.features.icon-picker",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Name new folders and pick their icons with a local model (a ~25MB download, once)",
    "property": "zia.features.folder-icon-suggest",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Hide the space's name at the top of the sidebar, keeping its icon",
    "property": "zia.sidebar.hide-space-name",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Show the space's name above the tabs, as Zen does",
    "property": "zia.sidebar.space-name-in-list",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Bookmarks, History and Synced Tabs panels in Zia's look",
    "property": "zia.sidebar-panels.style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Those panels beside the page, full height, as a second sidebar",
    "property": "zia.sidebar-panels.beside",
    "defaultValue": true,
    "conditions": [
      {
        "if": {
          "property": "zia.sidebar-panels.style",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Zen's own Library look (off: Zia's)",
    "property": "zia.library.zen-look",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Compact mode: the sidebar is see-through, the page blurred behind",
    "property": "zia.compact.sidebar-blur",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Compact mode: the top toolbar hides while the sidebar is out",
    "property": "zia.compact.hide-toolbar",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Address bar and new tabs",
    "id": "zia-section-address"
  },
  {
    "type": "checkbox",
    "label": "Zia's address bar pop-up (off: Zen's)",
    "property": "zia.urlbar.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "The pop-up is see-through, the page blurred behind",
    "property": "zia.urlbar.pop-up-blur",
    "defaultValue": true,
    "conditions": [
      {
        "if": {
          "property": "zia.urlbar.dia-style",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "The pop-up takes the toolbar's colour as it opens",
    "property": "zia.urlbar.site-color",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "zia.urlbar.dia-style",
          "value": true
        }
      },
      {
        "if": {
          "property": "zia.toolbar.site-color",
          "value": true
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "checkbox",
    "label": "Show only the page's title, in the domain's colour, until clicked",
    "property": "zia.urlbar.title-only",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Centre the address bar's text",
    "property": "zia.urlbar.center-text",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "Address bar position",
    "property": "zia.urlbar.position",
    "defaultValue": "top",
    "options": [
      {
        "label": "Top",
        "value": "top"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Zia's find in page bar",
    "property": "zia.features.find-bar",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Cmd/Ctrl+T and + New Tab open a real tab (off: Zen's floating address bar)",
    "property": "zia.newtab.real-tab",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "New tabs open your search engine's page (off: Zen's new tab page)",
    "property": "zia.newtab.search-engine",
    "defaultValue": true,
    "conditions": [
      {
        "if": {
          "property": "zia.newtab.real-tab",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "New tabs start in the address bar, ready to type",
    "property": "zia.newtab.focus-address-bar",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "zia.newtab.real-tab",
          "value": true
        }
      }
    ]
  },
  {
    "type": "separator",
    "label": "Page",
    "id": "zia-section-page"
  },
  {
    "type": "checkbox",
    "label": "Dia's round arrow when swiping back or forward, holding it lists the pages",
    "property": "zia.swipe.dia-arrow",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Drop cards when dragging a tab onto the page to split it (off: Zen's)",
    "property": "zia.split.drop-cards",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "PDFs in Zia's viewer look (reopen a PDF to see it)",
    "property": "zia.pdf.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Show where links go, at the foot of the page, as you hover them",
    "property": "zia.status-bar",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Hide the window buttons, for keyboard users",
    "property": "zia.window-buttons.hide",
    "defaultValue": false,
    "disabledOn": [
      "macos"
    ]
  },
  {
    "type": "checkbox",
    "label": "Window buttons just dim on hover (off: Windows' own)",
    "property": "zia.window-buttons.dim",
    "defaultValue": false,
    "disabledOn": [
      "macos",
      "linux"
    ]
  },
  {
    "type": "separator",
    "label": "Media",
    "id": "zia-section-media"
  },
  {
    "type": "checkbox",
    "label": "Music player card",
    "property": "zia.features.media-player",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "The music player stays when its video goes picture-in-picture",
    "property": "zia.media.keep-with-pip",
    "defaultValue": true,
    "conditions": [
      {
        "if": {
          "property": "zia.features.media-player",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "The music player shows a YouTube channel's picture, not the video's",
    "property": "zia.media.youtube-channel-art",
    "defaultValue": false,
    "conditions": [
      {
        "if": {
          "property": "zia.features.media-player",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "Zia's picture-in-picture controls (off: Firefox's)",
    "property": "zia.pip.dia-style",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Push picture-in-picture against a screen edge to tuck it away",
    "property": "zia.pip.tuck",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Picture-in-picture tucks into",
    "property": "zia.pip.tuck-spot",
    "defaultValue": "nearest",
    "options": [
      {
        "label": "The nearest side",
        "value": "nearest"
      },
      {
        "label": "Left side",
        "value": "left"
      },
      {
        "label": "Right side",
        "value": "right"
      },
      {
        "label": "Bottom",
        "value": "bottom"
      },
      {
        "label": "Bottom-left corner",
        "value": "bottom-left"
      },
      {
        "label": "Bottom-right corner",
        "value": "bottom-right"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.pip.tuck",
          "value": true
        }
      }
    ]
  },
  {
    "type": "checkbox",
    "label": "\"Add to Multiview\" on videos and tabs: a tab that grids up videos and streams",
    "property": "zia.multiview",
    "defaultValue": true
  },
  {
    "type": "dropdown",
    "label": "Multiview tab icon colour",
    "property": "zia.multiview.icon-color",
    "defaultValue": "zia",
    "options": [
      {
        "label": "Zia blue",
        "value": "zia"
      },
      {
        "label": "The space's colour",
        "value": "space"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.multiview",
          "value": true
        }
      }
    ]
  },
  {
    "type": "separator",
    "label": "Rename downloads with AI",
    "id": "zia-section-rename"
  },
  {
    "type": "checkbox",
    "label": "Rename finished downloads with AI, with an undo (restart after turning on)",
    "property": "zia.features.tidy-downloads",
    "defaultValue": false
  },
  {
    "type": "dropdown",
    "label": "AI service",
    "property": "extensions.downloads.ai_provider",
    "defaultValue": "mistral",
    "description": "Cloud providers first, then Ollama, OpenRouter, or any OpenAI-compatible endpoint.",
    "options": [
      {
        "label": "Mistral AI",
        "value": "mistral"
      },
      {
        "label": "OpenAI",
        "value": "openai"
      },
      {
        "label": "Anthropic",
        "value": "anthropic"
      },
      {
        "label": "Google Gemini",
        "value": "google"
      },
      {
        "label": "Ollama (local)",
        "value": "ollama"
      },
      {
        "label": "OpenRouter",
        "value": "openrouter"
      },
      {
        "label": "OpenAI-compatible endpoint",
        "value": "openai_compat"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      }
    ]
  },
  {
    "type": "string",
    "label": "Mistral API key",
    "property": "extensions.downloads.mistral_api_key",
    "placeholder": "Enter your Mistral API key",
    "defaultValue": "",
    "description": "Your API key from console.mistral.ai. The model list loads once this is set.",
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "mistral"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "label": "Mistral model",
    "property": "extensions.downloads.mistral_model",
    "defaultValue": "mistral-small-latest",
    "description": "Models available for your Mistral key. The list is fetched from Mistral when a key is set.",
    "options": [
      {
        "value": "mistral-small-latest",
        "label": "Mistral Small Latest"
      },
      {
        "value": "mistral-medium-latest",
        "label": "Mistral Medium Latest"
      },
      {
        "value": "mistral-large-latest",
        "label": "Mistral Large Latest"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "mistral"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "label": "OpenAI API key",
    "property": "extensions.downloads.openai_api_key",
    "placeholder": "Enter your OpenAI API key",
    "defaultValue": "",
    "description": "Your API key from platform.openai.com. The model list loads once this is set.",
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "openai"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "label": "OpenAI model",
    "property": "extensions.downloads.openai_model",
    "defaultValue": "gpt-4.1-mini",
    "description": "Models available for your OpenAI key. The list is fetched from OpenAI when a key is set.",
    "options": [
      {
        "value": "gpt-4.1-mini",
        "label": "GPT-4.1 Mini"
      },
      {
        "value": "gpt-4.1",
        "label": "GPT-4.1"
      },
      {
        "value": "gpt-4o",
        "label": "GPT-4o"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "openai"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "label": "Anthropic API key",
    "property": "extensions.downloads.anthropic_api_key",
    "placeholder": "Enter your Anthropic API key",
    "defaultValue": "",
    "description": "Your API key from console.anthropic.com. The model list loads once this is set.",
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "anthropic"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "label": "Anthropic model",
    "property": "extensions.downloads.anthropic_model",
    "defaultValue": "claude-sonnet-4-0",
    "description": "Models available for your Anthropic key. The list is fetched from Anthropic when a key is set.",
    "options": [
      {
        "value": "claude-sonnet-4-0",
        "label": "Claude Sonnet 4"
      },
      {
        "value": "claude-opus-4-0",
        "label": "Claude Opus 4"
      },
      {
        "value": "claude-3-5-haiku-latest",
        "label": "Claude 3.5 Haiku Latest"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "anthropic"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "label": "Google AI API key",
    "property": "extensions.downloads.google_api_key",
    "placeholder": "Enter your Google AI Studio API key",
    "defaultValue": "",
    "description": "Your API key from aistudio.google.com. The model list loads once this is set.",
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "google"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "label": "Gemini model",
    "property": "extensions.downloads.google_model",
    "defaultValue": "gemini-2.5-flash",
    "description": "Models available for your Google key. The list is fetched from Google when a key is set.",
    "options": [
      {
        "value": "gemini-2.5-flash",
        "label": "Gemini 2.5 Flash"
      },
      {
        "value": "gemini-2.5-pro",
        "label": "Gemini 2.5 Pro"
      },
      {
        "value": "gemini-2.0-flash",
        "label": "Gemini 2.0 Flash"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "google"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "string",
    "label": "Ollama base URL",
    "property": "extensions.downloads.ollama_base_url",
    "placeholder": "http://localhost:11434",
    "defaultValue": "http://localhost:11434",
    "description": "Your local Ollama server. No API key required. Installed models are listed from this host.",
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "ollama"
        }
      }
    ],
    "operator": "AND"
  },
  {
    "type": "dropdown",
    "label": "Ollama model",
    "property": "extensions.downloads.ollama_model",
    "defaultValue": "llama3.2",
    "description": "Models installed in your local Ollama instance. The list loads when Ollama is running.",
    "options": [
      {
        "value": "llama3.2",
        "label": "llama3.2"
      },
      {
        "value": "mistral",
        "label": "mistral"
      },
      {
        "value": "qwen2.5",
        "label": "qwen2.5"
      }
    ],
    "conditions": [
      {
        "if": {
          "property": "zia.features.tidy-downloads",
          "value": true
        }
      },
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "ollama"
        }
      }
    ],
    "operator": "AND"
  },
  {
